# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.railway.app

# Database — Railway provides DATABASE_URL automatically
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Legacy DB config (used if DATABASE_URL is not set)
# DB_NAME=chatconnect
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis — Railway provides REDIS_URL automatically
REDIS_URL=redis://localhost:6379/0

# LiveKit
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=ws://localhost:7880

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Email (SMTP) — required for the email-verification registration flow.
# Without EMAIL_HOST_USER/PASSWORD the backend falls back to printing
# verification codes to the Django log (useful for local dev).
#
# GoDaddy:   smtpout.secureserver.net : 465 (SSL)   or 587 (STARTTLS)
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=admin@qbared.com
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=Axonic <admin@qbared.com>
