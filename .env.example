# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.railway.app

# Database — Railway provides DATABASE_URL automatically
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Legacy DB config (used if DATABASE_URL is not set)
# DB_NAME=chatconnect
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis — Railway provides REDIS_URL automatically
REDIS_URL=redis://localhost:6379/0

# LiveKit
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=ws://localhost:7880

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Email — required for the email-verification registration flow.
# Three transports are supported, in priority order:
#
#  * Resend (HTTPS, recommended). Set RESEND_API_KEY.
#  * SendGrid (HTTPS). Set SENDGRID_API_KEY.
#  * SMTP (local dev only). Works on hosts that allow port 587/465.
#    Most PaaS providers (Railway, Fly.io, Render) block SMTP.
#
# Without any of the below the backend falls back to printing the
# verification code to the Django log (handy when developing).
#
# ---- Resend (recommended for prod) ----
RESEND_API_KEY=re_your-api-key-here
DEFAULT_FROM_EMAIL=Axonic <admin@qbared.com>
#
# ---- SendGrid (alternative) ----
# SENDGRID_API_KEY=SG.your-api-key-here
#
# ---- SMTP (local dev) ----
# Microsoft 365 (GoDaddy-hosted mailboxes are usually here):
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@qbared.com
EMAIL_HOST_PASSWORD=your-mailbox-password
